{
  "name": "orbis",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "packageManager": "pnpm@11.24.0",
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "validate": "pnpm --filter @orbis/content-schema test && pnpm test:presentation-platform && pnpm test:weekly-brief && pnpm test:content-registry && pnpm content:validate",
    "content:validate": "tsx tools/validate-content/index.ts",
    "path:guard": "tsx tools/path-guard/index.ts",
    "generate:slides": "tsx tools/generate-slides/index.ts",
    "slides:dev": "pnpm generate:slides && tsx tools/build-slides/index.ts --dev",
    "build:web": "pnpm --filter @orbis/web build",
    "build:slides": "tsx tools/build-slides/index.ts",
    "assemble": "tsx tools/assemble-site/index.ts",
    "test:site": "tsx tools/site-check/index.ts",
    "test:presentation-scope": "tsx tools/presentation-scope-check/index.ts",
    "test:multi-presentation": "tsx tools/multi-presentation-check/index.ts",
    "test:presentation-platform": "tsx tools/generate-slides/presentation-platform.test.ts && tsx tools/generate-slides/standalone-presentation.test.ts && tsx tools/generate-slides/standalone-source-validation.test.ts && tsx tools/generate-slides/weekly-v1.test.ts",
    "test:weekly-brief": "tsx tools/weekly-brief/weekly-schema.test.ts && tsx tools/weekly-brief/weekly-source-validation.test.ts",
    "test:content-registry": "tsx tools/validate-content/registry-contract.test.ts && tsx tools/validate-content/referential-integrity.test.ts",
    "test:weekly-artifact": "tsx tools/weekly-brief/weekly-artifact-check.ts",
    "build": "pnpm validate && pnpm test:multi-presentation && pnpm generate:slides && pnpm build:web && pnpm build:slides && pnpm assemble && pnpm test:site && pnpm test:presentation-scope && pnpm test:weekly-artifact"
  },
  "devDependencies": {
    "@orbis/content-schema": "workspace:*",
    "tsx": "4.23.12",
    "typescript": "5.9.3",
    "yaml": "2.8.3"
  }
}
