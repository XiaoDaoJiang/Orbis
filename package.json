{
  "name": "orbis",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "packageManager": "pnpm@11.24.0",
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "validate": "pnpm --filter @orbis/content-schema test && pnpm content:validate",
    "content:validate": "tsx tools/validate-content/index.ts",
    "path:guard": "tsx tools/path-guard/index.ts",
    "generate:slides": "tsx tools/generate-slides/index.ts",
    "slides:dev": "pnpm generate:slides && tsx tools/build-slides/index.ts --dev",
    "build:web": "pnpm --filter @orbis/web build",
    "build:slides": "tsx tools/build-slides/index.ts",
    "assemble": "tsx tools/assemble-site/index.ts",
    "test:prototype": "tsx tools/prototype-check/index.ts",
    "test:multi-presentation": "tsx tools/multi-presentation-check/index.ts",
    "build": "pnpm validate && pnpm test:multi-presentation && pnpm generate:slides && pnpm build:web && pnpm build:slides && pnpm assemble && pnpm test:prototype"
  },
  "devDependencies": {
    "@orbis/content-schema": "workspace:*",
    "tsx": "4.23.12",
    "typescript": "5.9.3",
    "yaml": "2.8.3"
  }
}
