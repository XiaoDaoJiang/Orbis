{
  "name": "orbis",
  "private": true,
  "version": "0.0.0",
  "packageManager": "pnpm@11.24.0",
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "validate": "pnpm --filter @orbis/content-schema test && pnpm content:validate",
    "content:validate": "tsx tools/validate-content/index.ts",
    "generate:slides": "tsx tools/generate-slides/index.ts",
    "build:web": "pnpm --filter @orbis/web build",
    "build:slides": "pnpm --filter @orbis/slides build:prototype",
    "assemble": "tsx tools/assemble-site/index.ts",
    "test:prototype": "tsx tools/prototype-check/index.ts",
    "build": "pnpm validate && pnpm generate:slides && pnpm build:web && pnpm build:slides && pnpm assemble && pnpm test:prototype"
  },
  "devDependencies": {
    "tsx": "4.23.12",
    "typescript": "5.9.3",
    "yaml": "2.8.3"
  },
  "pnpm": {
    "overrides": {
      "zod": "4.4.3"
    }
  }
}
