{
  "name": "orbis",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "packageManager": "pnpm@11.24.0",
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "validate": "pnpm --filter @orbis/content-schema test && pnpm test:presentation-platform && pnpm test:weekly-brief && pnpm test:content-registry && pnpm test:registry-ui-contract && pnpm test:seo-url && pnpm test:structured-data && pnpm test:knowledge-lifecycle && pnpm content:validate && pnpm knowledge:review && pnpm test:registry-ui-fixtures",
    "content:validate": "tsx tools/validate-content/index.ts",
    "knowledge:review": "tsx tools/knowledge-lifecycle/report.ts",
    "path:guard": "tsx tools/path-guard/index.ts",
    "generate:slides": "tsx tools/generate-slides/index.ts",
    "slides:dev": "pnpm generate:slides && tsx tools/build-slides/index.ts --dev",
    "build:web": "pnpm --filter @orbis/web build",
    "build:slides": "tsx tools/build-slides/index.ts",
    "assemble": "tsx tools/assemble-site/index.ts",
    "test:site": "tsx tools/site-check/index.ts",
    "test:presentation-scope": "tsx tools/presentation-scope-check/index.ts",
    "test:multi-presentation": "tsx tools/multi-presentation-check/index.ts",
    "test:presentation-platform": "tsx tools/generate-slides/presentation-platform.test.ts && tsx tools/generate-slides/standalone-presentation.test.ts && tsx tools/generate-slides/standalone-source-validation.test.ts && tsx tools/generate-slides/weekly-v1.test.ts",
    "test:weekly-brief": "tsx tools/weekly-brief/weekly-schema.test.ts && tsx tools/weekly-brief/weekly-source-validation.test.ts",
    "test:content-registry": "tsx tools/validate-content/registry-contract.test.ts && tsx tools/validate-content/referential-integrity-unit.test.ts && tsx tools/validate-content/referential-integrity.test.ts",
    "test:registry-ui-contract": "tsx tools/registry-ui-check/content-registry.test.ts",
    "test:registry-ui-fixtures": "tsx tools/registry-ui-check/fixture-build.test.ts",
    "test:registry-ui-artifact": "tsx tools/registry-ui-check/index.ts",
    "test:seo-url": "tsx tools/seo/url-contract.test.ts",
    "test:seo-web": "tsx tools/seo/web-artifact-check.ts",
    "test:seo-site": "tsx tools/seo/site-artifact-check.ts",
    "test:structured-data": "tsx tools/seo/json-ld-contract.test.ts",
    "test:structured-data-artifact": "tsx tools/seo/structured-data-artifact-check.ts",
    "test:knowledge-lifecycle": "tsx tools/knowledge-lifecycle/lifecycle-contract.test.ts && tsx tools/knowledge-lifecycle/relation-contract.test.ts && tsx tools/knowledge-lifecycle/report-contract.test.ts",
    "test:weekly-artifact": "tsx tools/weekly-brief/weekly-artifact-check.ts",
    "build": "pnpm validate && pnpm test:multi-presentation && pnpm generate:slides && pnpm build:web && pnpm test:seo-web && pnpm build:slides && pnpm assemble && pnpm test:site && pnpm test:presentation-scope && pnpm test:weekly-artifact && pnpm test:registry-ui-artifact && pnpm test:seo-site && pnpm test:structured-data-artifact"
  },
  "devDependencies": {
    "@orbis/content-schema": "workspace:*",
    "tsx": "4.23.12",
    "typescript": "5.9.3",
    "yaml": "2.8.3"
  }
}
