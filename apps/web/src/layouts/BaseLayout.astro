---
import '@orbis/design-tokens/tokens.css'
import '@orbis/design-tokens/appearance.css'
import { appearanceBootstrap } from '@orbis/design-tokens/appearance'
import AppearanceControl from '../components/AppearanceControl.astro'
import '../styles/global.css'
import { serializeJsonLd, type JsonLdValue } from '../lib/json-ld'
import { buildSeoMetadata } from '../lib/seo'

interface Props {
  title?: string
  description?: string
  canonicalPath?: string
  sharePath?: string
  type?: 'website' | 'article'
  imagePath?: string
  jsonLd?: JsonLdValue
}

const {
  title = 'Orbis',
  description = 'Essays, briefs, slides, topics and durable knowledge.',
  canonicalPath,
  sharePath,
  type = 'website',
  imagePath,
  jsonLd,
} = Astro.props
const base = import.meta.env.BASE_URL.replace(/\/$/, '')
const href = (path: string) => `${base}${path}`
const navigation = [
  ['Essays', '/essays/'], ['Briefs', '/briefs/'], ['Slides', '/slides/'],
  ['Topics', '/topics/'], ['Knowledge', '/knowledge/'], ['Archive', '/archive/'],
]
const currentPath = Astro.url.pathname.replace(new RegExp(`^${base}(?=/|$)`), '') || '/'
const seo = await buildSeoMetadata({
  pathname: Astro.url.pathname,
  runtimeBase: import.meta.env.BASE_URL,
  title,
  description,
  canonicalPath,
  sharePath,
  type,
  imagePath,
})
---
<!doctype html>
<html lang={seo.locale}>
  <head>
    <meta charset="utf-8" />
    <script is:inline set:html={appearanceBootstrap}></script>
    <meta name="viewport" content="width=device-width" />
    <meta name="description" content={seo.description} />
    <meta name="robots" content={seo.robots} />
    <link rel="canonical" href={seo.canonicalUrl} />
    <meta property="og:title" content={seo.title} />
    <meta property="og:description" content={seo.description} />
    <meta property="og:url" content={seo.shareUrl} />
    <meta property="og:type" content={seo.type} />
    <meta property="og:image" content={seo.imageUrl} />
    <meta property="og:locale" content={seo.locale} />
    <meta property="og:site_name" content={seo.siteName} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={seo.title} />
    <meta name="twitter:description" content={seo.description} />
    <meta name="twitter:image" content={seo.imageUrl} />
    {jsonLd && <script type="application/ld+json" set:html={serializeJsonLd(jsonLd)}></script>}
    <link rel="icon" href={href('/favicon.svg')} type="image/svg+xml" />
    <link rel="alternate" type="application/rss+xml" title="Orbis RSS" href={href('/rss.xml')} />
    <title>{title === 'Orbis' ? title : `${title} · Orbis`}</title>
  </head>
  <body>
    <a class="skip-link" href="#main-content">跳至主要内容</a>
    <header class="site-header">
      <div class="brand-lockup"><a class="wordmark" href={href('/')} aria-label="Orbis 首页">ORBIS<span class="wordmark-dot" aria-hidden="true">.</span></a><span class="brand-edition">轨道笔记<span>Orbital Notes</span></span></div>
      <nav aria-label="主导航">
        {navigation.map(([label, path]) => (
          <a href={href(path)} aria-current={currentPath.startsWith(path) ? 'page' : undefined}>{label}</a>
        ))}
        <a class="nav-rss" href={href('/rss.xml')} aria-label="通过 RSS 订阅">RSS <span aria-hidden="true">↗</span></a>
      </nav>
      <AppearanceControl />
    </header>
    <main id="main-content" tabindex="-1"><slot /></main>
    <footer>
      <span><strong>ORBIS · 轨道笔记</strong><br />Signals, systems and durable knowledge.</span>
      <div class="footer-links"><a href={href('/topics/')}>Topics</a><a href={href('/archive/')}>Archive</a><a href={href('/rss.xml')}>RSS</a></div>
    </footer>
  </body>
</html>
