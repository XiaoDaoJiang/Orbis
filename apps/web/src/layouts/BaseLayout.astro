---
import '@orbis/design-tokens/tokens.css'
import '../styles/global.css'
import { serializeJsonLd, type JsonLdValue } from '../lib/json-ld'
import { buildSeoMetadata } from '../lib/seo'

interface Props {
  title?: string
  description?: string
  canonicalPath?: string
  sharePath?: string
  type?: 'website' | 'article'
  imagePath?: string
  jsonLd?: JsonLdValue
}

const {
  title = 'Orbis',
  description = 'Essays, briefs, slides, topics and durable knowledge.',
  canonicalPath,
  sharePath,
  type = 'website',
  imagePath,
  jsonLd,
} = Astro.props
const base = import.meta.env.BASE_URL.replace(/\/$/, '')
const href = (path: string) => `${base}${path}`
const seo = await buildSeoMetadata({
  pathname: Astro.url.pathname,
  runtimeBase: import.meta.env.BASE_URL,
  title,
  description,
  canonicalPath,
  sharePath,
  type,
  imagePath,
})
---
<!doctype html>
<html lang={seo.locale}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="description" content={seo.description} />
    <meta name="robots" content={seo.robots} />
    <link rel="canonical" href={seo.canonicalUrl} />
    <meta property="og:title" content={seo.title} />
    <meta property="og:description" content={seo.description} />
    <meta property="og:url" content={seo.shareUrl} />
    <meta property="og:type" content={seo.type} />
    <meta property="og:image" content={seo.imageUrl} />
    <meta property="og:locale" content={seo.locale} />
    <meta property="og:site_name" content={seo.siteName} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={seo.title} />
    <meta name="twitter:description" content={seo.description} />
    <meta name="twitter:image" content={seo.imageUrl} />
    {jsonLd && <script type="application/ld+json" set:html={serializeJsonLd(jsonLd)}></script>}
    <link rel="icon" href={href('/favicon.svg')} type="image/svg+xml" />
    <link rel="alternate" type="application/rss+xml" title="Orbis RSS" href={href('/rss.xml')} />
    <title>{title === 'Orbis' ? title : `${title} · Orbis`}</title>
  </head>
  <body>
    <header class="site-header">
      <a class="wordmark" href={href('/')}>ORBIS</a>
      <nav aria-label="主导航">
        <a href={href('/essays/')}>Essays</a>
        <a href={href('/briefs/')}>Briefs</a>
        <a href={href('/slides/')}>Slides</a>
        <a href={href('/topics/')}>Topics</a>
        <a href={href('/knowledge/')}>Knowledge</a>
        <a href={href('/archive/')}>Archive</a>
        <a href={href('/rss.xml')}>RSS</a>
      </nav>
    </header>
    <main><slot /></main>
    <footer>
      <span>Orbis · Signals, systems and durable knowledge.</span>
      <a href={href('/rss.xml')}>Subscribe via RSS</a>
    </footer>
  </body>
</html>
