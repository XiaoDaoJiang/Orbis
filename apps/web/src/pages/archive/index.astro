---
import { getCollection } from 'astro:content'
import ContentTags from '../../components/ContentTags.astro'
import { archiveSearchText } from '../../lib/archive-filters'
import BaseLayout from '../../layouts/BaseLayout.astro'
import {
  isPublicBrief,
  isPublicEssay,
  isPublicKnowledge,
  isPublicTopic,
  sortDiscoveryNewestFirst,
  toBriefDiscoveryItem,
  toEssayDiscoveryItem,
  toKnowledgeDiscoveryItem,
} from '../../lib/content-discovery'

const base = import.meta.env.BASE_URL.replace(/\/$/, '')
const [briefEntries, essayEntries, knowledgeEntries, topicEntries] = await Promise.all([
  getCollection('briefs'),
  getCollection('essays'),
  getCollection('knowledge'),
  getCollection('topics'),
])

const items = sortDiscoveryNewestFirst([
  ...briefEntries.filter(isPublicBrief).map((entry) => toBriefDiscoveryItem(entry, base)),
  ...essayEntries.filter(isPublicEssay).map((entry) => toEssayDiscoveryItem(entry, base)),
  ...knowledgeEntries.filter(isPublicKnowledge).map((entry) => toKnowledgeDiscoveryItem(entry, base)),
])
const topics = topicEntries.filter(isPublicTopic).sort((left, right) => left.data.name.localeCompare(right.data.name))
---
<BaseLayout title="Archive" description="Browse published Orbis content by type, cadence and topic">
  <div class="eyebrow">Discover · Revisit · Connect</div>
  <h1>Archive</h1>
  <p class="lead">在技术信号、深度文章与长期知识之间，找到值得继续阅读的内容。</p>

  <form class="filters" id="archive-filters" aria-label="Archive filters" hidden>
    <label class="filter-control filter-search">
      <span>Search · 搜索</span>
      <input id="archive-search" type="search" placeholder="搜索标题、摘要、主题或标签" autocomplete="off" aria-controls="archive-results" />
    </label>
    <label class="filter-control">
      <span>Type · 内容类型</span>
      <select id="archive-kind" aria-controls="archive-results">
        <option value="all">All types</option>
        <option value="brief">Brief</option>
        <option value="essay">Essay</option>
        <option value="knowledge">Knowledge</option>
      </select>
    </label>
    <label class="filter-control">
      <span>Cadence · 更新频率</span>
      <select id="archive-cadence" aria-controls="archive-results">
        <option value="all">All cadences</option>
        <option value="daily">Daily</option>
        <option value="weekly">Weekly</option>
        <option value="ad-hoc">Ad-hoc</option>
      </select>
    </label>
    <label class="filter-control">
      <span>Topic · 主题</span>
      <select id="archive-topic" aria-controls="archive-results">
        <option value="all">All topics</option>
        {topics.map((topic) => <option value={topic.id}>{topic.data.name}</option>)}
      </select>
    </label>
  </form>
  <div class="archive-toolbar">
    <p id="archive-count" role="status" aria-live="polite" aria-atomic="true">共 {items.length} 篇内容</p>
    <button class="filter-reset" id="archive-reset" type="button" hidden>清除筛选</button>
  </div>
  <noscript><p class="lead">以下展示全部内容。开启 JavaScript 后可搜索和筛选。</p></noscript>

  <div class="grid archive-grid" id="archive-results">
    {items.map((item) => (
      <article
        class="card archive-item"
        data-archive-item
        data-kind={item.kind}
        data-cadence={item.cadence ?? ''}
        data-topics={item.topics.join(' ')}
        data-search={archiveSearchText(item)}
      >
        <small>{item.kind}{item.cadence ? ` · ${item.cadence}` : ''} · {item.publishedAt}</small>
        <h2><a href={item.href}>{item.title}</a></h2>
        <p>{item.summary}</p>
        {item.topics.length > 0 && <div class="pills">{item.topics.map((topic) => <span class="pill">{topic}</span>)}</div>}
        <ContentTags tags={item.tags} />
        <div class="link-row">
          <a href={item.href} aria-label={`Read: ${item.title}`}>Read →</a>
          {item.presentationHref && <a href={item.presentationHref} aria-label={`Presentation: ${item.title}`}>Presentation →</a>}
        </div>
      </article>
    ))}
  </div>

  <div class="empty-state archive-empty" id="archive-empty" hidden>
    <h2>没有找到匹配内容</h2>
    <p>试试更简短的关键词，或清除筛选后重新浏览。</p>
    <button class="button button-secondary" id="archive-empty-reset" type="button">清除全部筛选</button>
  </div>

  <script>
    import { emptyArchiveFilters, matchesArchiveFilters, normalizeArchiveFilters, readArchiveFilters, writeArchiveFilters } from '../../lib/archive-filters'

    const form = document.querySelector<HTMLFormElement>('#archive-filters')!
    const searchControl = document.querySelector<HTMLInputElement>('#archive-search')!
    const kindControl = document.querySelector<HTMLSelectElement>('#archive-kind')!
    const cadenceControl = document.querySelector<HTMLSelectElement>('#archive-cadence')!
    const topicControl = document.querySelector<HTMLSelectElement>('#archive-topic')!
    const cards = [...document.querySelectorAll<HTMLElement>('[data-archive-item]')]
    const emptyState = document.querySelector<HTMLElement>('#archive-empty')!
    const count = document.querySelector<HTMLElement>('#archive-count')!
    const reset = document.querySelector<HTMLButtonElement>('#archive-reset')!
    const emptyReset = document.querySelector<HTMLButtonElement>('#archive-empty-reset')!
    const topics = [...topicControl.options].map((option) => option.value)

    const setControls = (filters: typeof emptyArchiveFilters) => {
      searchControl.value = filters.query
      kindControl.value = filters.kind
      cadenceControl.value = filters.cadence
      topicControl.value = filters.topic
    }

    const applyFilters = (historyMode?: 'push' | 'replace') => {
      const filters = normalizeArchiveFilters({
        query: searchControl.value, kind: kindControl.value,
        cadence: cadenceControl.value, topic: topicControl.value,
      }, topics)
      cadenceControl.value = filters.cadence
      cadenceControl.disabled = filters.kind !== 'all' && filters.kind !== 'brief'
      let visible = 0
      for (const card of cards) {
        card.hidden = !matchesArchiveFilters({
          kind: card.dataset.kind ?? '', cadence: card.dataset.cadence ?? '',
          topics: (card.dataset.topics ?? '').split(' '), text: card.dataset.search ?? '',
        }, filters)
        if (!card.hidden) visible += 1
      }
      emptyState.hidden = visible !== 0
      count.textContent = `显示 ${visible} / ${cards.length} 篇内容`
      reset.disabled = !filters.query && filters.kind === 'all' && filters.cadence === 'all' && filters.topic === 'all'
      if (historyMode) {
        const url = new URL(window.location.href)
        url.search = writeArchiveFilters(url.searchParams, filters).toString()
        if (url.href !== window.location.href) {
          window.history[historyMode === 'push' ? 'pushState' : 'replaceState'](null, '', url)
        }
      }
    }

    const restoreFromUrl = () => {
      setControls(readArchiveFilters(new URLSearchParams(window.location.search), topics))
      applyFilters()
    }
    const clearFilters = () => {
      setControls(emptyArchiveFilters)
      applyFilters('push')
      searchControl.focus()
    }
    searchControl.addEventListener('input', () => applyFilters('replace'))
    for (const control of [kindControl, cadenceControl, topicControl]) {
      control.addEventListener('change', () => applyFilters('push'))
    }
    form.addEventListener('submit', (event) => { event.preventDefault(); applyFilters('push') })
    reset.addEventListener('click', clearFilters)
    emptyReset.addEventListener('click', clearFilters)
    window.addEventListener('popstate', restoreFromUrl)
    window.addEventListener('pageshow', restoreFromUrl)
    restoreFromUrl()
    form.hidden = false
    reset.hidden = false
  </script>
</BaseLayout>
