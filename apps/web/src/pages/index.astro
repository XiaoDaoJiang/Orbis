---
import { getCollection } from 'astro:content'
import BaseLayout from '../layouts/BaseLayout.astro'
import {
  isPublicBrief,
  isPublicEssay,
  isPublicKnowledge,
  isPublicTopic,
  sortDiscoveryNewestFirst,
  toBriefDiscoveryItem,
  toEssayDiscoveryItem,
  toKnowledgeDiscoveryItem,
  getRelatedContent,
} from '../lib/content-discovery'
import { buildWebSiteJsonLd } from '../lib/json-ld'
import { buildPublicPresentations } from '../lib/presentation-discovery'
import { webSiteConfig } from '../lib/site-config'
import { buildKnowledgeLifecycleViews } from '../lib/knowledge-lifecycle'

const [briefEntries, essayEntries, knowledgeEntries, topicEntries, presentationEntries, nativePresentationEntries] = await Promise.all([
  getCollection('briefs'),
  getCollection('essays'),
  getCollection('knowledge'),
  getCollection('topics'),
  getCollection('presentations'),
  getCollection('nativePresentations'),
])
const base = import.meta.env.BASE_URL.replace(/\/$/, '')

const briefs = sortDiscoveryNewestFirst(
  briefEntries.filter(isPublicBrief).map((entry) => toBriefDiscoveryItem(entry, base)),
)
const essays = sortDiscoveryNewestFirst(
  essayEntries.filter(isPublicEssay).map((entry) => toEssayDiscoveryItem(entry, base)),
)
const presentations = buildPublicPresentations(briefEntries, presentationEntries, nativePresentationEntries, base)
const knowledgeUpdates = knowledgeEntries
  .filter(isPublicKnowledge)
  .sort((left, right) =>
    (right.data.updatedAt ?? right.data.publishedAt).localeCompare(left.data.updatedAt ?? left.data.publishedAt)
    || left.data.title.localeCompare(right.data.title)
    || left.id.localeCompare(right.id))
  .slice(0, 3)
const topics = topicEntries
  .filter(isPublicTopic)
  .sort((left, right) => left.data.name.localeCompare(right.data.name) || left.id.localeCompare(right.id))

const latestBrief = briefs[0]
const latestEssay = essays[0]
const latestPresentation = presentations[0]
const jsonLd = buildWebSiteJsonLd(webSiteConfig)

const topicNames = new Map(topics.map((topic) => [topic.id, topic.data.name]))
const knowledge = knowledgeEntries.filter(isPublicKnowledge).map((entry) => toKnowledgeDiscoveryItem(entry, base))
const related = latestBrief ? [
  ...getRelatedContent(latestBrief, essays, 1),
  ...getRelatedContent(latestBrief, knowledge, 1),
] : []
const relatedIds = new Set(related.map((entry) => `${entry.kind}:${entry.id}`))
const lifecycle = new Map(buildKnowledgeLifecycleViews(knowledgeEntries.map((entry) => ({
  id: entry.id, status: entry.data.status, reviewAt: entry.data.reviewAt, supersededBy: entry.data.supersededBy,
}))).map((view) => [view.id, view]))
const sharedTopics = (entry: { topics: string[] }) => entry.topics.filter((topic) => latestBrief?.topics.includes(topic)).map((topic) => topicNames.get(topic) ?? topic)
const reviewLabel = (id: string) => {
  const view = lifecycle.get(id)
  if (!view?.reviewAt) return '持续维护 · 未设复查日期'
  const label = view.reviewHealth === 'overdue' ? '复查已到期' : view.reviewHealth === 'due-soon' ? '即将复查' : '计划复查'
  return `${label} · ${view.reviewAt}`
}
---
<BaseLayout jsonLd={jsonLd}>
  {latestBrief ? (
    <section class="orbital-hero" data-home-section="latest-brief">
      <article class="issue-lead" data-home-id={`brief:${latestBrief.id}`}>
        <div class="issue-meta"><span>{latestBrief.publishedAt}</span><span>{latestBrief.cadence}</span><span>本期信号</span></div>
        <h1>{latestBrief.title}</h1>
        <p class="lead issue-summary">{latestBrief.summary}</p>
        <div class="discovery-links hero-actions">
          <a class="button button-primary" href={latestBrief.href}>阅读本期 <span aria-hidden="true">→</span></a>
          {latestBrief.presentationHref && <a class="button button-quiet" href={latestBrief.presentationHref}>演示版 <span aria-hidden="true">↗</span></a>}
        </div>
      </article>
      <aside class="issue-context" aria-label="本期主题">
        <div class="orbit-illustration" aria-hidden="true"></div>
        <div class="context-caption"><span class="eyebrow">本期主题</span><p>从信号出发，沿主题深入。</p></div>
        <div class="topic-links">{latestBrief.topics.filter((id) => topicNames.has(id)).map((id) => <a href={`${base}/topics/${id}/`}>{topicNames.get(id)}</a>)}</div>
      </aside>
    </section>
  ) : <section><h1>Orbis</h1><p class="lead">从信号出发，沿主题深入。</p><a class="button button-primary" href={`${base}/archive/`}>浏览全部内容</a></section>}

  {related.length > 0 && <section class="reading-path" aria-labelledby="reading-path-title">
    <div class="section-title"><h2 id="reading-path-title">沿主题深入</h2><span>按共同主题关联</span></div>
    <div class="reading-entries">
      {related.map((item) => <article class="reading-entry" data-home-id={`${item.kind}:${item.id}`} data-home-section={item.kind === 'essay' ? 'latest-essay' : 'knowledge-updates'} data-related-topics={sharedTopics(item).join(', ')}>
        <div class="entry-meta"><span>{item.kind}</span><time datetime={item.publishedAt}>{item.publishedAt}</time></div>
        <div><h3><a href={item.href}>{item.title}</a></h3><p>{item.summary}</p><div class="entry-relation">共同主题：{sharedTopics(item).join(' · ')}</div>{item.kind === 'knowledge' && <p class="review-note">{reviewLabel(item.id)}</p>}</div>
      </article>)}
    </div>
  </section>}

  {latestEssay && !relatedIds.has(`essay:${latestEssay.id}`) && <section data-home-section="latest-essay" class="recent-writing">
    <div class="section-title"><h2>最近的长文</h2><a href={`${base}/essays/`}>全部 Essays</a></div>
    <article class="reading-entry" data-home-id={`essay:${latestEssay.id}`}><div class="entry-meta">Essay · {latestEssay.publishedAt}</div><div><h3><a href={latestEssay.href}>{latestEssay.title}</a></h3><p>{latestEssay.summary}</p></div></article>
  </section>}

  <section class="orbis-map" data-home-section="explore" aria-labelledby="orbis-map-title">
    <div class="section-title"><h2 id="orbis-map-title">信号不是终点</h2><span>Orbis · 有来源的阅读，持续维护的知识</span></div>
    <div class="content-paths">
      <a href={`${base}/briefs/`}><small>01 / Briefs</small><h3>观察信号</h3><p>从 Daily 与 Weekly 进入事实、判断和引用。</p></a>
      <a href={`${base}/essays/`}><small>02 / Essays</small><h3>展开思考</h3><p>围绕一个问题，读完整的论述与上下文。</p></a>
      <a href={`${base}/knowledge/`}><small>03 / Knowledge</small><h3>持续复查</h3><p>知识有维护状态、复查日期，也可能被更新替代。</p></a>
    </div>
    <div class="map-footnote"><span>沿时间观察，围绕主题连接。</span><div><a href={`${base}/briefs/daily/`}>Daily</a><a href={`${base}/briefs/weekly/`}>Weekly</a><a href={`${base}/archive/`}>完整档案</a></div></div>
  </section>

  <div class="home-index">
    <section data-home-section="active-topics">
      <div class="section-title"><h2>主题是连接</h2><a href={`${base}/topics/`}>全部 Topics</a></div>
      <p class="index-note">跨越不同内容形式，继续追踪同一个问题。</p>
      <div class="topic-index">{topics.map((topic) => <a data-home-topic={topic.id} href={`${base}/topics/${topic.id}/`}><strong>{topic.data.name}</strong><span>{topic.data.description}</span></a>)}</div>
    </section>
    <section data-home-section="latest-presentation">
      <div class="section-title"><h2>另一种表达</h2><a href={`${base}/slides/`}>全部 Slides</a></div>
      {latestPresentation && <article class="presentation-note" data-home-id={`presentation:${latestPresentation.id}`} data-presentation-source={latestPresentation.sourceKind}>
        <small>{latestPresentation.sourceKind === 'brief' ? 'Brief presentation' : latestPresentation.sourceKind === 'native' ? 'Native Slidev' : 'Standalone presentation'} · {latestPresentation.publishedAt}</small>
        <h3><a href={latestPresentation.presentationHref}>{latestPresentation.title}</a></h3>
        <p>{latestPresentation.sourceKind === 'brief' ? '同一份内容，切换为演示视图。' : latestPresentation.summary}</p>
        <div class="link-row"><a href={latestPresentation.presentationHref}>打开演示</a>{latestPresentation.readingHref && <a href={latestPresentation.readingHref}>阅读原文</a>}</div>
      </article>}
    </section>
  </div>

  {knowledgeUpdates.some((entry) => !relatedIds.has(`knowledge:${entry.id}`)) && <section data-home-section="knowledge-updates">
    <div class="section-title"><h2>知识维护</h2><a href={`${base}/knowledge/`}>全部 Knowledge</a></div>
    {knowledgeUpdates.filter((entry) => !relatedIds.has(`knowledge:${entry.id}`)).map((entry) => <article class="reading-entry" data-home-id={`knowledge:${entry.id}`}><div class="entry-meta">Knowledge<br />{reviewLabel(entry.id)}</div><div><h3><a href={`${base}/knowledge/${entry.id}/`}>{entry.data.title}</a></h3><p>{entry.data.summary}</p></div></article>)}
  </section>}
</BaseLayout>
