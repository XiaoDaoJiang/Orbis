---
import { getCollection } from 'astro:content'
import BaseLayout from '../../layouts/BaseLayout.astro'
const entries = (await getCollection('essays', ({ data }) => data.status === 'published')).sort((a, b) => b.data.publishedAt.localeCompare(a.data.publishedAt))
const base = import.meta.env.BASE_URL.replace(/\/$/, '')
---
<BaseLayout title="Essays" description="Orbis long-form essays">
  <div class="eyebrow">Long-form writing</div><h1>Essays</h1>
  <div class="grid">{entries.map((entry) => <a class="card" href={`${base}/essays/${entry.id}/`}><small>{entry.data.publishedAt}</small><h3>{entry.data.title}</h3><p>{entry.data.description}</p></a>)}</div>
</BaseLayout>
