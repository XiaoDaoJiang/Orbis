---
import { getCollection } from 'astro:content'
import AdjacentContentNav from '../../components/AdjacentContentNav.astro'
import RelatedContent from '../../components/RelatedContent.astro'
import AdHocBriefBody from '../../components/briefs/AdHocBriefBody.astro'
import DailyBriefBody from '../../components/briefs/DailyBriefBody.astro'
import WeeklyBriefBody from '../../components/briefs/WeeklyBriefBody.astro'
import BaseLayout from '../../layouts/BaseLayout.astro'
import { buildSourceIndex } from '../../lib/content-registry'
import {
  buildPublicDiscoveryItems,
  getDailyAdjacency,
  getRelatedContentSnapshot,
  isPublicBrief,
  toBriefDiscoveryItem,
} from '../../lib/content-discovery'
import {
  adjacentContentCacheIdentity,
  buildContentPageCacheKey,
  selectEntriesById,
} from '../../lib/incremental-cache'
import { buildBriefJsonLd } from '../../lib/json-ld'
import { webSiteConfig } from '../../lib/site-config'

export async function getStaticPaths() {
  const [briefEntries, essayEntries, knowledgeEntries, sourceEntries] = await Promise.all([
    getCollection('briefs'),
    getCollection('essays'),
    getCollection('knowledge'),
    getCollection('sources'),
  ])
  const base = import.meta.env.BASE_URL.replace(/\/$/, '')
  const candidates = buildPublicDiscoveryItems(briefEntries, essayEntries, knowledgeEntries, base)

  return briefEntries.filter(isPublicBrief).map((entry) => {
    const current = toBriefDiscoveryItem(entry, base)
    const related = getRelatedContentSnapshot(current, candidates)
    const adjacent = entry.data.cadence === 'daily' ? getDailyAdjacency(briefEntries, entry.id, base) : {}
    const scopedSourceEntries = selectEntriesById(
      sourceEntries,
      entry.data.references.map((reference) => reference.source),
      'source',
    )

    return {
      params: { id: entry.id },
      props: {
        entry,
        sourceEntries: scopedSourceEntries,
        related,
        adjacent,
      },
      cacheKey: buildContentPageCacheKey({
        scope: 'brief',
        entry,
        dependencyGroups: [
          { name: 'sources', entries: scopedSourceEntries },
        ],
        related,
        extra: {
          adjacent: entry.data.cadence === 'daily'
            ? adjacentContentCacheIdentity(adjacent)
            : null,
        },
      }),
    }
  })
}

const { entry, sourceEntries, related, adjacent } = Astro.props
const sourceIndex = buildSourceIndex(sourceEntries)
const base = import.meta.env.BASE_URL.replace(/\/$/, '')
const dailyBrief = entry.data.cadence === 'daily' ? entry.data : undefined
const weeklyBrief = entry.data.cadence === 'weekly' ? entry.data : undefined
const adHocBrief = entry.data.cadence === 'ad-hoc' ? entry.data : undefined
const jsonLd = buildBriefJsonLd(webSiteConfig, {
  title: entry.data.title,
  description: entry.data.summary,
  publishedAt: entry.data.publishedAt,
  canonicalPath: `/briefs/${entry.id}/`,
})
---
<BaseLayout title={entry.data.title} description={entry.data.summary} type="article" jsonLd={jsonLd}>
  <article class="article">
    <header class="article-header">
      <div class="eyebrow">Brief · {entry.data.cadence} · {entry.data.publishedAt}</div>
      <h1>{entry.data.title}</h1>
      <p class="lead">{entry.data.summary}</p>
      <div class="pills">{entry.data.topics.map((topic) => <span class="pill">{topic}</span>)}</div>
      {entry.data.presentation.enabled && <p><a href={`${base}/slides/${entry.id}/`}>打开演示版 →</a></p>}
    </header>
    {dailyBrief && <DailyBriefBody brief={dailyBrief} sourceIndex={sourceIndex} />}
    {weeklyBrief && <WeeklyBriefBody brief={weeklyBrief} sourceIndex={sourceIndex} />}
    {adHocBrief && <AdHocBriefBody brief={adHocBrief} sourceIndex={sourceIndex} />}
  </article>
  <AdjacentContentNav previous={adjacent.previous} next={adjacent.next} />
  <RelatedContent items={related} />
</BaseLayout>
