---
import { getCollection } from 'astro:content'
import AdjacentContentNav from '../../components/AdjacentContentNav.astro'
import RelatedContent from '../../components/RelatedContent.astro'
import BaseLayout from '../../layouts/BaseLayout.astro'
import {
  buildPublicDiscoveryItems,
  getDailyAdjacency,
  getRelatedContent,
  isPublicBrief,
  toBriefDiscoveryItem,
} from '../../lib/content-discovery'

export async function getStaticPaths() {
  const [briefEntries, essayEntries, knowledgeEntries] = await Promise.all([
    getCollection('briefs'),
    getCollection('essays'),
    getCollection('knowledge'),
  ])
  const base = import.meta.env.BASE_URL.replace(/\/$/, '')
  const candidates = buildPublicDiscoveryItems(briefEntries, essayEntries, knowledgeEntries, base)

  return briefEntries.filter(isPublicBrief).map((entry) => {
    const current = toBriefDiscoveryItem(entry, base)
    return {
      params: { id: entry.id },
      props: {
        entry,
        related: getRelatedContent(current, candidates),
        adjacent: entry.data.cadence === 'daily' ? getDailyAdjacency(briefEntries, entry.id, base) : {},
      },
    }
  })
}

const { entry, related, adjacent } = Astro.props
const base = import.meta.env.BASE_URL.replace(/\/$/, '')
---
<BaseLayout title={entry.data.title} description={entry.data.summary}>
  <article class="article">
    <header class="article-header">
      <div class="eyebrow">Brief · {entry.data.cadence} · {entry.data.publishedAt}</div>
      <h1>{entry.data.title}</h1>
      <p class="lead">{entry.data.summary}</p>
      <div class="pills">{entry.data.topics.map((topic) => <span class="pill">{topic}</span>)}</div>
      {entry.data.presentation.enabled && <p><a href={`${base}/slides/${entry.id}/`}>打开演示版 →</a></p>}
    </header>
    <div class="article-body">
      <h2>Four signals</h2>
      <ul class="signal-list">{entry.data.signals.map((signal) => <li><strong>{signal.title}</strong><p>{signal.summary}</p></li>)}</ul>
      {entry.data.sections.map((section) => (
        <section>
          <h2>{section.title}</h2>
          <p><strong>{section.conclusion}</strong></p>
          <ul>{section.facts.map((fact) => <li>{fact}</li>)}</ul>
          {section.limitations.length > 0 && <p><small>限制：{section.limitations.join('；')}</small></p>}
        </section>
      ))}
      <h2>From signals to action</h2>
      <ul class="action-list">{entry.data.actions.map((action) => <li><strong>{action.title}</strong><p>{action.description}</p></li>)}</ul>
      <h2>References</h2>
      <ol class="reference-list">{entry.data.references.map((reference) => <li><a href={reference.url}>{reference.title}</a> — {reference.supports}</li>)}</ol>
    </div>
  </article>
  <AdjacentContentNav previous={adjacent.previous} next={adjacent.next} />
  <RelatedContent items={related} />
</BaseLayout>
