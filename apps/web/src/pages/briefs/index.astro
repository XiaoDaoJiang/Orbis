---
import { getCollection } from 'astro:content'
import BaseLayout from '../../layouts/BaseLayout.astro'
import {
  isPublicBrief,
  sortDiscoveryNewestFirst,
  toBriefDiscoveryItem,
} from '../../lib/content-discovery'

const base = import.meta.env.BASE_URL.replace(/\/$/, '')
const entries = sortDiscoveryNewestFirst(
  (await getCollection('briefs')).filter(isPublicBrief).map((entry) => toBriefDiscoveryItem(entry, base)),
)
---
<BaseLayout title="Briefs" description="Structured daily, weekly and ad-hoc briefs">
  <div class="eyebrow">Structured signals</div>
  <h1>Briefs</h1>
  <p class="lead">浏览全部已发布 Brief，或按 cadence 进入稳定的 Daily / Weekly 入口。</p>
  <div class="discovery-links" aria-label="Brief cadence navigation">
    <a class="pill" href={`${base}/briefs/daily/`}>Daily Briefs</a>
    <a class="pill" href={`${base}/briefs/weekly/`}>Weekly Briefs</a>
  </div>
  <div class="grid">
    {entries.map((entry) => (
      <a class="card" href={entry.href}>
        <small>{entry.cadence} · {entry.publishedAt}</small>
        <h3>{entry.title}</h3>
        <p>{entry.summary}</p>
      </a>
    ))}
  </div>
</BaseLayout>
