---
import { getCollection } from 'astro:content'
import BaseLayout from '../../layouts/BaseLayout.astro'
import { buildPublicPresentations } from '../../lib/presentation-discovery'

const base = import.meta.env.BASE_URL.replace(/\/$/, '')
const [briefs, presentations, nativePresentations] = await Promise.all([
  getCollection('briefs'),
  getCollection('presentations'),
  getCollection('nativePresentations'),
])
const entries = buildPublicPresentations(briefs, presentations, nativePresentations, base)
---
<BaseLayout title="Presentations" description="Published Orbis presentations from structured Briefs, standalone templates, and native Slidev talks">
  <div class="eyebrow">Presentation discovery</div>
  <h1>Presentations</h1>
  <p class="lead">统一浏览结构化 Brief 派生演示、模板化独立 Presentation，以及直接以原生 Slidev Markdown 编写的技术分享。</p>
  {entries.length > 0 ? (
    <div class="grid">
      {entries.map((entry) => (
        <article class="card" data-presentation-id={entry.id} data-presentation-source={entry.sourceKind}>
          <small>
            {entry.sourceKind === 'brief'
              ? `Brief presentation · ${entry.cadence} · ${entry.publishedAt}`
              : entry.sourceKind === 'native'
                ? `Native Slidev · ${entry.publishedAt}`
                : `Standalone presentation · ${entry.publishedAt}`}
          </small>
          <h3>{entry.title}</h3>
          <p>{entry.summary}</p>
          <div class="pills">{entry.topics.map((topic) => <span class="pill">{topic}</span>)}</div>
          <div class="link-row">
            <a href={entry.presentationHref}>Open presentation →</a>
            {entry.readingHref && <a href={entry.readingHref}>Read brief →</a>}
          </div>
        </article>
      ))}
    </div>
  ) : (
    <div class="empty-state">No published presentations are available.</div>
  )}
</BaseLayout>
