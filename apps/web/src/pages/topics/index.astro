---
import { getCollection } from 'astro:content'
import BaseLayout from '../../layouts/BaseLayout.astro'
const topics = await getCollection('topics', ({ data }) => data.status !== 'archived')
const base = import.meta.env.BASE_URL.replace(/\/$/, '')
---
<BaseLayout title="Topics"><div class="eyebrow">Knowledge map</div><h1>Topics</h1><div class="grid">{topics.map((topic) => <a class="card" href={`${base}/topics/${topic.id}/`}><small>{topic.data.status}</small><h3>{topic.data.name}</h3><p>{topic.data.description}</p></a>)}</div></BaseLayout>
