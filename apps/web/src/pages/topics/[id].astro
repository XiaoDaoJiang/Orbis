---
import { getCollection } from 'astro:content'
import BaseLayout from '../../layouts/BaseLayout.astro'
import {
  isPublicBrief,
  isPublicEssay,
  isPublicKnowledge,
  isPublicTopic,
  sortDiscoveryNewestFirst,
} from '../../lib/content-discovery'

export async function getStaticPaths() {
  return (await getCollection('topics'))
    .filter(isPublicTopic)
    .map((entry) => ({ params: { id: entry.id }, props: { entry } }))
}

const { entry } = Astro.props
const [essayEntries, briefEntries, knowledgeEntries] = await Promise.all([
  getCollection('essays'),
  getCollection('briefs'),
  getCollection('knowledge'),
])
const matches = sortDiscoveryNewestFirst([
  ...essayEntries.filter(isPublicEssay).filter((item) => item.data.topics.includes(entry.id)).map((item) => ({ id: item.id, title: item.data.title, kind: 'essay', publishedAt: item.data.publishedAt })),
  ...briefEntries.filter(isPublicBrief).filter((item) => item.data.topics.includes(entry.id)).map((item) => ({ id: item.id, title: item.data.title, kind: 'brief', publishedAt: item.data.publishedAt })),
  ...knowledgeEntries.filter(isPublicKnowledge).filter((item) => item.data.topics.includes(entry.id)).map((item) => ({ id: item.id, title: item.data.title, kind: 'knowledge', publishedAt: item.data.publishedAt })),
])
const base = import.meta.env.BASE_URL.replace(/\/$/, '')
---
<BaseLayout title={entry.data.name} description={entry.data.description}>
  <div class="eyebrow">Topic</div>
  <h1>{entry.data.name}</h1>
  <p class="lead">{entry.data.description}</p>
  <p class="index-note">按发布日期，由近及远。</p>
  <div class="grid">
    {matches.map((item) => (
      <a class="card" href={`${base}/${item.kind === 'essay' ? 'essays' : item.kind === 'brief' ? 'briefs' : 'knowledge'}/${item.id}/`}>
        <small>{item.kind} · {item.publishedAt}</small>
        <h2>{item.title}</h2>
      </a>
    ))}
  </div>
</BaseLayout>
