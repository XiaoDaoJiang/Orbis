---
import { getCollection } from 'astro:content'
import BaseLayout from '../../layouts/BaseLayout.astro'
const entries = await getCollection('knowledge', ({ data }) => data.status === 'published' || data.status === 'active')
const base = import.meta.env.BASE_URL.replace(/\/$/, '')
---
<BaseLayout title="Knowledge"><div class="eyebrow">Durable knowledge</div><h1>Knowledge</h1><div class="grid">{entries.map((entry) => <a class="card" href={`${base}/knowledge/${entry.id}/`}><small>{entry.data.status}</small><h3>{entry.data.title}</h3><p>{entry.data.summary}</p></a>)}</div></BaseLayout>
