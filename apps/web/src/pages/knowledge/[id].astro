---
import { getCollection, render } from 'astro:content'
import ReferenceList from '../../components/ReferenceList.astro'
import RelatedContent from '../../components/RelatedContent.astro'
import BaseLayout from '../../layouts/BaseLayout.astro'
import { buildSourceIndex } from '../../lib/content-registry'
import {
  buildPublicDiscoveryItems,
  getRelatedContent,
  isPublicKnowledge,
  toKnowledgeDiscoveryItem,
} from '../../lib/content-discovery'

export async function getStaticPaths() {
  const [briefEntries, essayEntries, knowledgeEntries, sourceEntries] = await Promise.all([
    getCollection('briefs'),
    getCollection('essays'),
    getCollection('knowledge'),
    getCollection('sources'),
  ])
  const base = import.meta.env.BASE_URL.replace(/\/$/, '')
  const candidates = buildPublicDiscoveryItems(briefEntries, essayEntries, knowledgeEntries, base)

  return knowledgeEntries.filter(isPublicKnowledge).map((entry) => {
    const current = toKnowledgeDiscoveryItem(entry, base)
    return {
      params: { id: entry.id },
      props: {
        entry,
        sourceEntries,
        related: getRelatedContent(current, candidates),
      },
    }
  })
}

const { entry, sourceEntries, related } = Astro.props
const sourceIndex = buildSourceIndex(sourceEntries)
const { Content } = await render(entry)
---
<BaseLayout title={entry.data.title} description={entry.data.summary} type="article">
  <article class="article">
    <header class="article-header">
      <div class="eyebrow">Knowledge · review {entry.data.reviewAt ?? 'not scheduled'}</div>
      <h1>{entry.data.title}</h1>
      <p class="lead">{entry.data.summary}</p>
      <div class="pills">{entry.data.topics.map((topic) => <span class="pill">{topic}</span>)}</div>
    </header>
    <div class="article-body">
      <Content />
      {entry.data.references.length > 0 && (
        <section class="article-references">
          <h2>References</h2>
          <ReferenceList references={entry.data.references} sourceIndex={sourceIndex} />
        </section>
      )}
    </div>
  </article>
  <RelatedContent items={related} />
</BaseLayout>
